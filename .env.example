NODE_ENV=development
PORT=5500
DATABASE_URL=postgresql://user:password@localhost:5432/registagro
DATABASE_URL_DOCKER=postgresql://user:password@postgres:5432/registagro
DATABASE_POOL_MAX=5
REDIS_URL=redis://localhost:6379
CACHE_TTL_SECONDS=30
TRUST_PROXY_HOPS=1
SECRET_KEY=replace-with-a-random-secret-of-at-least-32-characters
TURNSTILE_SECRET_KEY=
TURNSTILE_HOSTNAME=
GEOAPIFY_KEY=
RESEND_API_KEY=
PAYMENT_TRANSPORT_PERCENT=30
PAYMENT_REGISTAGRO_PERCENT=5
