generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
  runtime  = "nodejs"
}

datasource db {
  provider = "postgresql"
}

enum Province {
  Luanda
  Bengo
}

model Company {
  id           String   @id @default(uuid())
  nif          String
  name         String
  type         String   @default("farm")
  location     String
  province     Province
  municipality String
  phone        Int      @unique()
  email        String   @unique()

  @@map("company")
}

enum Rule {
  farm
  consumer
  carrier
  admin
}

enum Deleted {
  active
  inactive
  pendent
}

model Users {
  id         String      @id @default(uuid())
  name       String
  email      String      @unique()
  phone      String
  password   String
  rule       Rule
  adress     String
  province   Province
  created_at DateTime    @default(now())
  status     Deleted     @default(pendent)
  profile    String
  farms      Farms[]
  consumers  Consumers[]
  carriers   Carriers[]
  refreshSessions refresh_sessions[]

  @@map("users")
}

model refresh_sessions {
  id        String    @id @default(uuid())
  userId    String
  user      Users     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, expiresAt])
  @@map("refresh_sessions")
}

model Farms {
  id       String     @id @default(uuid())
  nif      String     @unique
  balance  Float      @default(0)
  farm     Users      @relation(fields: [farmId], references: [id])
  farmId   String
  products Products[]
  orders   Orders[]

  @@map("farms")
}

model Consumers {
  id         String   @id @default(uuid())
  consumer   Users    @relation(fields: [consumerId], references: [id])
  consumerId String
  orders     Orders[]

  @@map("consumers")
}

model Carriers {
  id                String               @id @default(uuid())
  carrier           Users                @relation(fields: [carrierId], references: [id])
  carrierId         String
  balance           Float                @default(0)
  busy              Boolean              @default(false)
  vehicles          Vehicles[]
  routes            Routes[]
  transportRequests Transport_requests[]
  locations         Location[]

  @@map("carriers")
}

enum Stock {
  kg
  t
}

enum ProductsType {
  frutas
  vegetais
  cereais
  carnes
  raizes
  legumes
}

model Products {
  id          String       @id @default(uuid())
  farm        Farms        @relation(fields: [farmId], references: [id])
  farmId      String
  name        String
  description String
  price       Float
  stock       Int
  transport   VehiclesType
  unit        Stock
  type        ProductsType
  created_at  DateTime     @default(now())
  photo       String
  status      Deleted      @default(active)
  orders      Orders[]

  @@index([farmId, type])
  @@index([status, created_at])
  @@map("products")
}

enum orders_status {
  pendent
  confirmed
  canceled
  rejected
  ongoing
  delivered
  inactive
  deleted
  incollection
}

model Orders {
  id                 String               @id @default(uuid())
  consumer           Consumers            @relation(fields: [consumerId], references: [id])
  consumerId         String
  farm               Farms                @relation(fields: [farmId], references: [id])
  farmId             String
  product            Products             @relation(fields: [productId], references: [id])
  productId          String
  qtd                Int
  unit               Stock
  value              Float
  status             orders_status        @default(pendent)
  delivery           String
  created_at         DateTime             @default(now())
  payments           Payments[]
  requests_transport Transport_requests[]
  location           Location[]

  @@index([farmId, status])
  @@index([consumerId, status])
  @@index([created_at])
  @@map("orders")
}

enum Payment_status {
  pendent
  retained
  released
  canceled
}

model Payments {
  id              String         @id @default(uuid())
  order           Orders         @relation(fields: [orderId], references: [id])
  orderId         String
  reference       String         @unique
  productValue    Float
  transportValue  Float
  registagroValue Float
  farmValue       Float
  value           Float
  status          Payment_status @default(pendent)
  created_at      DateTime       @default(now())

  @@map("payments")
}

enum VehiclesType {
  frigorifico
  fechado
  aberto_coberto
  aberto
}

model Vehicles {
  id                String               @id @default(uuid())
  carrier           Carriers             @relation(fields: [carrierId], references: [id])
  carrierId         String
  brand             String
  plate             String               @unique
  type              VehiclesType
  capacity          Int
  unit              Stock
  photo             String
  status            Deleted              @default(active)
  transportRequests Transport_requests[]

  @@map("vehicles")
}

enum Requests {
  pendente
  aceite
  em_transporte
  entregue
  cancelado
  rejeitado
  aguardando_coleta
}

model Transport_requests {
  id           String    @id @default(uuid())
  order        Orders    @relation(fields: [orderId], references: [id])
  orderId      String
  carrier      Carriers  @relation(fields: [carrierId], references: [id])
  carrierId    String
  vehicle      Vehicles  @relation(fields: [vehicleId], references: [id])
  vehicleId    String
  status       Requests  @default(pendente)
  start_at     DateTime?
  delivered_at DateTime?

  @@index([carrierId, status])
  @@index([orderId])
  @@index([vehicleId])
  @@map("transport_requests")
}

enum Duration {
  dias
  horas
}

model Routes {
  id           String   @id @default(uuid())
  carrier      Carriers @relation(fields: [carrierId], references: [id])
  carrierId    String
  origin       String
  destination  String
  capacity     Int
  unit         Stock
  duration     Int
  durationUnit Duration

  @@map("routes")
}

model Location {
  id        String   @id @default(uuid())
  carrier   Carriers @relation(fields: [carrierId], references: [id])
  carrierId String
  order     Orders   @relation(fields: [orderId], references: [id])
  orderId   String
  longitude String
  latitude  String
  time      DateTime @default(now())
  update_at DateTime?
  active    Boolean  @default(true)

  @@index([orderId, time])
  @@index([carrierId, time])
  @@map("location")
}
